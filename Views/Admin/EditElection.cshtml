@model ElectionFormViewModel
@{
    ViewData["Title"] = "Edytuj wybory";
    int electionId = ViewBag.ElectionId;
}
<h2>Edytuj wybory</h2>
<p class="text-muted">Zmiana dat działa od razu: przesuń datę zakończenia wstecz, żeby zamknąć głosowanie i zobaczyć wyniki, albo do przodu, żeby je otworzyć.</p>
<hr />
<partial name="_StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form asp-action="EditElection" asp-route-id="@electionId" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group mb-3">
                <label asp-for="Opis" class="form-label"></label>
                <input asp-for="Opis" class="form-control" />
                <span asp-validation-for="Opis" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DataRozpoczecia" class="form-label"></label>
                <input asp-for="DataRozpoczecia" class="form-control" />
                <span asp-validation-for="DataRozpoczecia" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DataZakonczenia" class="form-label"></label>
                <input asp-for="DataZakonczenia" class="form-control" />
                <span asp-validation-for="DataZakonczenia" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Zapisz</button>
            <a class="btn btn-link" asp-action="Elections">Wróć do listy</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
