@model ElectionFormViewModel
@{
    ViewData["Title"] = "Edytuj wybory";
    int electionId = ViewBag.ElectionId;
    var started = Model.Status is ElectionStatus.Ongoing or ElectionStatus.Ended;
    var ended = Model.Status == ElectionStatus.Ended;
}
<h2>Edytuj wybory</h2>
@if (ended)
{
    <p class="text-muted">Głosowanie się zakończyło. Można poprawić tylko nazwę, daty zostają bez zmian.</p>
}
else if (started)
{
    <p class="text-muted">Głosowanie trwa. Data rozpoczęcia jest już ustalona. Datę zakończenia można przesunąć, także na teraz, żeby zamknąć głosowanie, ale nie przed ostatni oddany głos.</p>
}
else
{
    <p class="text-muted">Głosowanie jeszcze się nie rozpoczęło, więc można zmienić nazwę i obie daty.</p>
}
<hr />
<partial name="_StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form asp-action="EditElection" asp-route-id="@electionId" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group mb-3">
                <label asp-for="Opis" class="form-label"></label>
                <input asp-for="Opis" class="form-control" />
                <span asp-validation-for="Opis" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DataRozpoczecia" class="form-label"></label>
                <input asp-for="DataRozpoczecia" class="form-control" readonly="@started" />
                <span asp-validation-for="DataRozpoczecia" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DataZakonczenia" class="form-label"></label>
                <input asp-for="DataZakonczenia" class="form-control" readonly="@ended" />
                <span asp-validation-for="DataZakonczenia" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Zapisz</button>
            <a class="btn btn-link" asp-action="Elections">Wróć do listy</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
