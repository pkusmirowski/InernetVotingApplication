@model IReadOnlyList<AuditEntryViewModel>
@{
    ViewData["Title"] = "Dziennik audytu";
}
<h2>Dziennik audytu</h2>
<p class="text-muted">Ostatnie @Model.Count wpisów: działania administratorów i zdarzenia łańcucha.</p>
<hr />
@if (Model.Count == 0)
{
    <p>Brak wpisów.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr><th>Czas</th><th>Użytkownik</th><th>Akcja</th><th>Szczegóły</th></tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td class="text-nowrap">@entry.Date.ToString("g")</td>
                        <td>@(entry.UserId?.ToString() ?? "system")</td>
                        <td><code>@entry.Action</code></td>
                        <td class="small">@entry.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
