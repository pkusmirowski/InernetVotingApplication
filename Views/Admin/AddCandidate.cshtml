@model CandidateFormViewModel
@{
    ViewData["Title"] = "Dodaj kandydata";
}
<h2>Dodaj kandydata</h2>
<hr />
<partial name="_StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form asp-action="AddCandidate" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group mb-3">
                <label asp-for="IdWybory" class="form-label"></label>
                <select asp-for="IdWybory" class="form-select" asp-items="ViewBag.Elections">
                    <option value="">-- wybierz wybory --</option>
                </select>
                <span asp-validation-for="IdWybory" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Imie" class="form-label"></label>
                <input asp-for="Imie" class="form-control" />
                <span asp-validation-for="Imie" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Nazwisko" class="form-label"></label>
                <input asp-for="Nazwisko" class="form-control" />
                <span asp-validation-for="Nazwisko" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Dodaj</button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
