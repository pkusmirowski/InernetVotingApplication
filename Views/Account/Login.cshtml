@model Logowanie
@{
    ViewData["Title"] = "Logowanie";
}
<h2>Logowanie</h2>
<hr />
<partial name="_StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Haslo" class="form-label"></label>
                <input asp-for="Haslo" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Haslo" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Zaloguj się</button>
            <a class="btn btn-link" asp-action="PasswordRecovery">Nie pamiętam hasła</a>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
