@model PasswordRecovery
@{
    ViewData["Title"] = "Odzyskanie hasła";
}
<h2>Odzyskanie hasła</h2>
<hr />
<p>Podaj adres e-mail konta. Jeśli konto istnieje i jest aktywne, wyślemy na nie link do ustawienia nowego hasła.</p>
<div class="row">
    <div class="col-md-6">
        <form asp-action="PasswordRecovery" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Wyślij link</button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
