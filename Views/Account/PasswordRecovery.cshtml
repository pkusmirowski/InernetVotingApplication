@model PasswordRecovery
@{
    ViewData["Title"] = "Przypomnienie hasła";
}
<h2>Nie pamiętasz hasła?</h2>
<hr />
<p>Wpisz adres e-mail podany przy rejestracji. Jeśli mamy konto z tym adresem, wyślemy na niego link, którym ustawisz nowe hasło.</p>
<div class="row">
    <div class="col-md-6">
        <form asp-action="PasswordRecovery" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Wyślij link</button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
