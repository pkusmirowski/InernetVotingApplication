@model RegisterViewModel
@{
    ViewData["Title"] = "Rejestracja";
}
<h2>Rejestracja</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group mb-3">
                <label asp-for="Imie" class="form-label"></label>
                <input asp-for="Imie" class="form-control" autocomplete="given-name" />
                <span asp-validation-for="Imie" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Nazwisko" class="form-label"></label>
                <input asp-for="Nazwisko" class="form-control" autocomplete="family-name" />
                <span asp-validation-for="Nazwisko" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Pesel" class="form-label"></label>
                <input asp-for="Pesel" class="form-control" inputmode="numeric" maxlength="11" />
                <span asp-validation-for="Pesel" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DataUrodzenia" class="form-label"></label>
                <input asp-for="DataUrodzenia" class="form-control" autocomplete="bday" />
                <span asp-validation-for="DataUrodzenia" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Haslo" class="form-label"></label>
                <input asp-for="Haslo" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Haslo" class="text-danger"></span>
                <div class="form-text">Co najmniej 8 znaków, mała i duża litera, cyfra oraz znak specjalny.</div>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Zarejestruj się</button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
