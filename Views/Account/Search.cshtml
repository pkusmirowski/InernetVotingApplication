@model VoteSearchViewModel
@{
    ViewData["Title"] = "Sprawdź głos";
}
<h2>Sprawdź swój głos</h2>
<p>Wprowadź hash otrzymany po oddaniu głosu. Jeśli głos znajduje się w łańcuchu, zobaczysz jego dane oraz wynik weryfikacji integralności całego łańcucha wyborów.</p>
<hr />
<form asp-action="Search" method="get" class="mb-4">
    <div class="input-group">
        <input class="form-control hash-value" asp-for="Hash" name="hash" placeholder="64 znaki szesnastkowe" />
        <button type="submit" class="btn btn-primary">Szukaj</button>
    </div>
</form>
@if (Model.Searched)
{
    if (Model.Found)
    {
        <div class="alert @(Model.ChainValid ? "alert-success" : "alert-danger")" role="alert">
            @if (Model.ChainValid)
            {
                <span>Głos został znaleziony, a łańcuch tych wyborów jest nienaruszony (weryfikacja @(Model.VerifiedAt?.ToString("g"))).</span>
            }
            else
            {
                <span>Głos został znaleziony, ale łańcuch tych wyborów <b>nie przechodzi weryfikacji</b>. Skontaktuj się z administratorem.</span>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-striped">
                <tbody>
                    <tr><th scope="row">Wybory</th><td>@Model.ElectionName</td></tr>
                    <tr><th scope="row">Kandydat</th><td>@Model.CandidateName @Model.CandidateSurname</td></tr>
                    <tr><th scope="row">Numer bloku</th><td>@Model.BlockIndex</td></tr>
                    <tr><th scope="row">Czas zapisu</th><td>@Model.Timestamp.ToString("g")</td></tr>
                    <tr><th scope="row">Hash</th><td class="hash-value">@Model.Hash</td></tr>
                    <tr><th scope="row">Podpis bloku</th><td class="hash-value small">@Model.Signature</td></tr>
                    <tr><th scope="row">Łańcuch</th><td><a asp-controller="Election" asp-action="Chain" asp-route-id="@Model.ElectionId">stan łańcucha, kotwice i eksport</a></td></tr>
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">Nie znaleziono głosu o podanym hashu.</div>
    }
}
