@inject InternetVotingApplication.Data.DatabaseInfo DatabaseInfo
@inject IWebHostEnvironment HostEnvironment
@inject Microsoft.Extensions.Options.IOptions<InternetVotingApplication.Configuration.AppOptions> AppOptions
@{
    var contactEmail = AppOptions.Value.ContactEmail;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] – Głosowanie internetowe</title>
    <meta content="Głosowanie internetowe. Po oddaniu głosu dostajesz kod potwierdzenia i możesz sprawdzić, czy Twój głos jest zapisany." name="description">

    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/css/style.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/site.css" rel="stylesheet" asp-append-version="true">
</head>
<body>
    <header id="header" class="fixed-top d-flex align-items-center">
        <div class="container d-flex align-items-center justify-content-between">
            <div class="logo">
                <h1 class="text-light"><span><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Głosowanie internetowe</a></span></h1>
            </div>
            <nav id="navbar" class="navbar">
                <ul>
                    <li><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Strona główna</a></li>
                    @if (!signedIn)
                    {
                        <li><a class="nav-link" asp-controller="Account" asp-action="Register">Rejestracja</a></li>
                        <li><a class="nav-link" asp-controller="Account" asp-action="Login">Zaloguj się</a></li>
                        <li><a class="nav-link" asp-controller="Account" asp-action="PasswordRecovery">Przypomnij hasło</a></li>
                        <li><a class="nav-link" asp-controller="Account" asp-action="Search">Sprawdź głos</a></li>
                    }
                    else if (User.IsInRole(Roles.Admin))
                    {
                        <li><a class="nav-link" asp-controller="Admin" asp-action="Panel">Panel administratora</a></li>
                        <li><a class="nav-link" asp-controller="Admin" asp-action="Elections">Wybory</a></li>
                        <li><a class="nav-link" asp-controller="Admin" asp-action="AddCandidate">Dodaj kandydata</a></li>
                        <li><a class="nav-link" asp-controller="Admin" asp-action="Users">Użytkownicy</a></li>
                        <li><a class="nav-link" asp-controller="Admin" asp-action="Audit">Audyt</a></li>
                        <li><a class="nav-link" asp-controller="Account" asp-action="ChangePassword">Zmiana hasła</a></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="nav-link btn btn-link">Wyloguj się</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li><a class="nav-link" asp-controller="Election" asp-action="Dashboard">Panel głosowania</a></li>
                        <li><a class="nav-link" asp-controller="Account" asp-action="ChangePassword">Zmiana hasła</a></li>
                        <li><a class="nav-link" asp-controller="Account" asp-action="Search">Sprawdź głos</a></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="nav-link btn btn-link">Wyloguj się</button>
                            </form>
                        </li>
                    }
                    <li><a class="nav-link" asp-controller="Home" asp-action="Privacy">Prywatność</a></li>
                    <li><a class="nav-link" asp-controller="Home" asp-action="Contact">Kontakt</a></li>
                </ul>
                <i class="bi bi-list mobile-nav-toggle"></i>
            </nav>
        </div>
    </header>

    @if (ViewData["FullWidth"] is true)
    {
        @RenderBody()
    }
    else
    {
        <main id="main" class="page-content">
            <div class="container">
                @RenderBody()
            </div>
        </main>
    }

    <footer id="footer">
        <div class="footer-top">
            <div class="container">
                <div class="row">
                    @if (!string.IsNullOrWhiteSpace(contactEmail))
                    {
                        <div class="col-lg-4 col-md-6 footer-contact">
                            <h3>Kontakt</h3>
                            <p><strong>Adres e-mail:</strong> <a href="mailto:@contactEmail">@contactEmail</a></p>
                        </div>
                    }
                    <div class="col-lg-4 col-md-6 footer-links">
                        <h4>Przydatne linki</h4>
                        <ul>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Home" asp-action="Index">Strona główna</a></li>
                            @if (!signedIn)
                            {
                                <li><i class="bi bi-chevron-right"></i> <a asp-controller="Account" asp-action="Register">Rejestracja</a></li>
                                <li><i class="bi bi-chevron-right"></i> <a asp-controller="Account" asp-action="Login">Zaloguj się</a></li>
                                <li><i class="bi bi-chevron-right"></i> <a asp-controller="Account" asp-action="PasswordRecovery">Przypomnij hasło</a></li>
                            }
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Account" asp-action="Search">Sprawdź głos</a></li>
                            <li><i class="bi bi-chevron-right"></i> <a asp-controller="Home" asp-action="Privacy">Prywatność</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-4 col-md-6 footer-links">
                        <h4>O aplikacji</h4>
                        <p>Każdy oddany głos trafia do rejestru, w którym każda zmiana zostałaby wykryta. Po głosowaniu dostajesz kod potwierdzenia i możesz w każdej chwili sprawdzić, czy Twój głos jest zapisany bez zmian.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="container py-4">
            <div class="copyright">
                &copy; @DateTime.Now.Year – Głosowanie internetowe
            </div>
            <div class="credits">
                Wersja @AppVersion.Value &middot; Szablon: <a href="https://bootstrapmade.com/">BootstrapMade</a>
            </div>
        </div>
    </footer>

    @if (DatabaseInfo.IsSqlite && HostEnvironment.IsDevelopment())
    {
        <div class="dev-banner alert @(DatabaseInfo.IsFallback ? "alert-warning" : "alert-info") mb-0" role="status">
            @if (DatabaseInfo.IsFallback)
            {
                <b>Tryb zapasowy:</b> <span>SQL Server nie odpowiedział, aplikacja działa na pliku SQLite <code>@DatabaseInfo.SqliteFilePath</code>. Dane nie trafiają do SQL Servera.</span>
            }
            else
            {
                <b>Tryb deweloperski:</b> <span>baza SQLite w pliku <code>@DatabaseInfo.SqliteFilePath</code>.</span>
            }
            <a href="~/setup" class="ms-2">Diagnostyka</a>
        </div>
    }
    else if (HostEnvironment.IsDevelopment())
    {
        <div class="dev-banner alert alert-light border mb-0" role="status">
            <span>Środowisko Development, baza SQL Server.</span>
            <a href="~/setup" class="ms-2">Diagnostyka</a>
        </div>
    }

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/main.js" asp-append-version="true"></script>
    <script src="~/assets/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
