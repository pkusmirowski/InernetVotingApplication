@inject Microsoft.Extensions.Options.IOptions<InternetVotingApplication.Configuration.AppOptions> AppOptions
@{
    ViewData["Title"] = "Kontakt";
    var contactEmail = AppOptions.Value.ContactEmail;
}
<h2>Kontakt</h2>
<hr />
<section id="contact" class="contact">
    @if (string.IsNullOrWhiteSpace(contactEmail))
    {
        <p>Dane kontaktowe nie zostały jeszcze skonfigurowane. Administrator może je ustawić w konfiguracji aplikacji (<code>App:ContactEmail</code>).</p>
        <p>Odpowiedzi na najczęstsze pytania znajdziesz na <a asp-controller="Home" asp-action="Index">stronie głównej</a>.</p>
    }
    else
    {
        <div class="info">
            <div class="email">
                <i class="bi bi-envelope"></i>
                <h4>Adres e-mail:</h4>
                <p><a href="mailto:@contactEmail">@contactEmail</a></p>
            </div>
        </div>
        <h4 class="mt-4">Napisz do nas</h4>
        <p>Masz pytanie o rejestrację, aktywację konta albo sprawdzanie głosu? Napisz na adres <a href="mailto:@contactEmail">@contactEmail</a>.</p>
    }
</section>
