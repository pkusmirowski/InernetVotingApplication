@{
    ViewData["Title"] = "Kontakt";
}
<h2>Kontakt</h2>
        <hr />
        <section id="contact" class="contact">
            <div class="container">
                <div class="row">
                    <div class="col-lg-5 d-flex align-items-stretch">
                        <div class="info">
                            <div class="address">
                                <i class="bi bi-geo-alt"></i>
                                <h4>Adres:</h4>
                                <p>ul. Przykładowa 40/50, 55-555 Warszawa, Polska</p>
                            </div>
                            <div class="email">
                                <i class="bi bi-envelope"></i>
                                <h4>Adres e-mail:</h4>
                                <p>info@twojadomena.pl</p>
                            </div>
                            <div class="phone">
                                <i class="bi bi-phone"></i>
                                <h4>Numer telefonu:</h4>
                                <p>+48 000 000 000</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-7 mt-5 mt-lg-0 d-flex align-items-stretch">
                        <div class="w-100 d-flex flex-column justify-content-center">
                            <h4>Napisz do nas</h4>
                            <p>Masz pytanie o rejestrację, aktywację konta albo sprawdzanie głosu? Napisz na adres <a href="mailto:info@twojadomena.pl">info@twojadomena.pl</a>. Odpowiadamy w dni robocze.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
