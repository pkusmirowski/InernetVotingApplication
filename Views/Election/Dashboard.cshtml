@model DataWyborowViewModel
@{
    ViewData["Title"] = "Panel głosowania";
}
<h2>Panel głosowania</h2>
<p>Tutaj widzisz wszystkie wybory. Gdy głosowanie trwa, możesz oddać głos. Wyniki pokazujemy po zakończeniu wyborów.</p>
<hr />
@if (Model.Elections.Count == 0)
{
    <p>Nie ma jeszcze żadnych wyborów. Zajrzyj tu ponownie później.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Wybory</th>
                    <th scope="col">Początek</th>
                    <th scope="col">Koniec</th>
                    <th scope="col">Liczba kandydatów</th>
                    <th scope="col">Stan</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var election in Model.Elections)
                {
                    <tr>
                        <td>@election.Opis</td>
                        <td>@election.DataRozpoczecia.ToString("g")</td>
                        <td>@election.DataZakonczenia.ToString("g")</td>
                        <td>@election.CandidateCount</td>
                        <td>
                            @switch (election.Status)
                            {
                                case ElectionStatus.Upcoming:
                                    <span class="badge bg-secondary">Jeszcze się nie rozpoczęły</span>
                                    break;
                                case ElectionStatus.Ongoing:
                                    <span class="badge bg-success">Głosowanie trwa</span>
                                    break;
                                default:
                                    <span class="badge bg-dark">Zakończone</span>
                                    break;
                            }
                            @if (election.HasVoted)
                            {
                                <span class="badge bg-info text-dark">Twój głos jest oddany</span>
                            }
                        </td>
                        <td>
                            @if (election.Status == ElectionStatus.Ongoing && !election.HasVoted)
                            {
                                <a class="btn btn-sm btn-primary" asp-action="Voting" asp-route-id="@election.Id">Zagłosuj</a>
                            }
                            else if (election.Status == ElectionStatus.Ended)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="ElectionResult" asp-route-id="@election.Id">Zobacz wyniki</a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="ElectionResult" asp-route-id="@election.Id">Szczegóły</a>
                            }
                            <a class="btn btn-sm btn-link" asp-action="Chain" asp-route-id="@election.Id">Rejestr głosów</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
