@model ChainViewModel
@{
    ViewData["Title"] = "Rejestr głosów";
}
<h2>Rejestr głosów: @Model.ElectionName</h2>
<p class="text-muted">@Model.DataRozpoczecia.ToString("g") &ndash; @Model.DataZakonczenia.ToString("g")</p>
<hr />
<p>Każdy oddany głos trafia do rejestru głosów. Wpisy w rejestrze są ze sobą powiązane, więc zmiana albo usunięcie nawet jednego głosu wychodzi na jaw przy najbliższej kontroli. W rejestrze nie ma informacji o tym, kto głosował.</p>

<h4 class="mt-4">Stan rejestru</h4>
<table class="table table-sm">
    <tbody>
        <tr><th scope="row">Wybory</th><td>@(Model.Status switch { ElectionStatus.Upcoming => "jeszcze się nie rozpoczęły", ElectionStatus.Ongoing => "głosowanie trwa", _ => "zakończone" })</td></tr>
        <tr><th scope="row">Liczba zapisanych głosów</th><td>@Model.BlockCount</td></tr>
        <tr>
            <th scope="row">Wynik ostatniej kontroli</th>
            <td>
                @if (Model.LastVerification is null)
                {
                    <span class="text-muted">kontroli jeszcze nie było</span>
                }
                else
                {
                    <span class="badge @(Model.LastVerification.IsValid ? "bg-success" : "bg-danger")">@(Model.LastVerification.IsValid ? "bez zastrzeżeń" : "wykryto nieprawidłowości")</span>
                    <span>@Model.LastVerification.Date.ToString("g"), sprawdzono głosów: @Model.LastVerification.BlockCount (@InternetVotingApplication.Services.ChainService.DescribeTrigger(Model.LastVerification.Trigger))</span>
                    @if (!Model.LastVerification.IsValid)
                    {
                        <div class="small text-danger">Zapisane głosy mogły zostać zmienione. Wyniki tych wyborów mogą być niewiarygodne.</div>
                    }
                }
            </td>
        </tr>
    </tbody>
</table>

<h4 class="mt-4">Kopie kontrolne</h4>
<p class="small text-muted">Co pewien czas zapisywany jest podpisany stan rejestru, a jeśli skonfigurowano odbiorców, także wysyłany e-mailem do komisji wyborczej. Dzięki tym kopiom można wykryć podmianę głosów nawet wtedy, gdyby dokonała jej osoba z dostępem do serwera.</p>
@if (Model.Anchors.Count == 0)
{
    <p>Nie ma jeszcze żadnej kopii kontrolnej.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr><th scope="col">Data wysłania</th><th scope="col">Rodzaj</th><th scope="col">Liczba głosów w rejestrze</th></tr>
            </thead>
            <tbody>
                @foreach (var anchor in Model.Anchors)
                {
                    <tr>
                        <td>@anchor.Date.ToString("g")</td>
                        <td>@InternetVotingApplication.Services.ChainService.DescribeReason(anchor.Reason)</td>
                        <td>@anchor.BlockCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h4 class="mt-4">Sprawdź samodzielnie</h4>
@if (Model.Status == ElectionStatus.Ended)
{
    <p>Nie musisz wierzyć nam na słowo. Cały rejestr można pobrać i sprawdzić własnym, niezależnym programem.</p>
    <a class="btn btn-outline-primary btn-sm" asp-action="Export" asp-route-id="@Model.ElectionId">Pobierz rejestr głosów (plik JSON)</a>
    <p class="small text-muted mt-2">Plik zawiera wszystkie wpisy, listę kandydatów, kopie kontrolne i klucz publiczny. Do sprawdzenia służy narzędzie <code>tools/ChainVerifier</code>.</p>
}
else
{
    <p class="small text-muted">Cały rejestr będzie można pobrać i sprawdzić samodzielnie po zakończeniu wyborów. Wcześniej go nie udostępniamy, żeby nie ujawniać cząstkowych wyników w trakcie głosowania.</p>
}

<details class="mt-4">
    <summary>Szczegóły techniczne</summary>
    <div class="mt-3">
        <p class="small text-muted">Rejestr to łańcuch bloków: każdy wpis (blok) zawiera hash SHA-256 poprzedniego wpisu i podpis elektroniczny ECDSA P-256.</p>
        <table class="table table-sm">
            <tbody>
                <tr><th scope="row">Hash ostatniego bloku (głowa łańcucha)</th><td class="hash-value">@(Model.HeadHash ?? "(pusty łańcuch)")</td></tr>
                <tr><th scope="row">Identyfikator klucza podpisu</th><td><code>@Model.KeyId</code></td></tr>
                @if (!string.IsNullOrEmpty(Model.LastVerification?.Details))
                {
                    <tr><th scope="row">Szczegóły ostatniej kontroli</th><td class="small text-danger">@Model.LastVerification.Details</td></tr>
                }
            </tbody>
        </table>
        <p class="small mb-1">Klucz publiczny do sprawdzania podpisów:</p>
        <pre class="small bg-light p-2 border rounded">@Model.PublicKeyPem</pre>
        @if (Model.Anchors.Count > 0)
        {
            <p class="small mb-1">Kopie kontrolne (kotwice):</p>
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr><th scope="col">Czas</th><th scope="col">Bloki</th><th scope="col">Hash głowy</th><th scope="col">Podpis</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var anchor in Model.Anchors)
                        {
                            <tr>
                                <td>@anchor.Date.ToString("g")</td>
                                <td>@anchor.BlockCount</td>
                                <td class="hash-value small">@(anchor.HeadHash ?? "(pusty)")</td>
                                <td class="hash-value small">@anchor.Signature</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</details>

@if (Model.Results != null)
{
    <h4 class="mt-4">Wyniki</h4>
    <p>Liczba oddanych głosów: <b>@Model.Results.TotalVotes</b></p>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr><th scope="col">Kandydat</th><th scope="col">Liczba głosów</th><th scope="col">Procent głosów</th><th scope="col" class="w-25"></th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Results.Rows)
                {
                    <tr>
                        <td>@row.CandidateName @row.CandidateSurname</td>
                        <td>@row.CountedVotes</td>
                        <td>@row.CountedVotesPercentage.ToString("0.##") %</td>
                        <td><div class="results-bar"><div style="width: @row.CountedVotesPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div></div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
