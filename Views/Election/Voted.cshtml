@model VoteReceiptViewModel
@{
    ViewData["Title"] = "Głos oddany";
}
<h2 class="text-success">Dziękujemy, Twój głos został zapisany</h2>
<p>Wybory: <b>@Model.ElectionName</b></p>
<hr />
<div class="alert alert-info" role="alert">
    <b>Zachowaj kod potwierdzenia.</b> To jedyny sposób, żeby później sprawdzić, czy Twój głos jest zapisany i czy nikt go nie zmienił. Kod wysłaliśmy też na Twój adres e-mail.
</div>
<p class="fs-5 mb-1">Twój kod potwierdzenia:</p>
<p class="hash-value fs-5"><b>@Model.Hash</b></p>
<p class="small text-muted">Nie pokazuj kodu innym osobom. Każdy, kto go zna, może sprawdzić, na kogo oddano ten głos.</p>
<a class="btn btn-primary" asp-controller="Account" asp-action="Search" asp-route-hash="@Model.Hash">Sprawdź swój głos</a>
<a class="btn btn-link" asp-action="Dashboard">Wróć do listy wyborów</a>
