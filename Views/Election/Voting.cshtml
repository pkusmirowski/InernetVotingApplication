@model KandydatViewModel
@{
    ViewData["Title"] = "Głosowanie";
}
<h2>@Model.ElectionName</h2>
<p class="text-muted">Głosowanie trwa do @Model.DataZakonczenia.ToString("g"). Zaznacz jednego kandydata i kliknij „Oddaj głos”. Możesz zagłosować tylko raz, a oddanego głosu nie da się zmienić ani cofnąć.</p>
<hr />
@if (Model.Candidates.Count == 0)
{
    <div class="alert alert-warning" role="alert">W tych wyborach nie ma jeszcze kandydatów, więc nie można oddać głosu. Zajrzyj tu ponownie później.</div>
    <a class="btn btn-link" asp-action="Dashboard">Wróć do listy wyborów</a>
}
else
{
    <form asp-action="Vote" method="post" data-confirm="Czy na pewno chcesz oddać głos na zaznaczonego kandydata? Tej decyzji nie da się zmienić ani cofnąć.">
        <input type="hidden" asp-for="ElectionId" />
        <span asp-validation-for="SelectedCandidateId" class="text-danger d-block mb-2"></span>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Zaznacz</th>
                        <th scope="col">Imię</th>
                        <th scope="col">Nazwisko</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var candidate in Model.Candidates)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input" type="radio" name="SelectedCandidateId" id="candidate-@candidate.Id" value="@candidate.Id" required />
                            </td>
                            <td><label class="form-check-label w-100" for="candidate-@candidate.Id">@candidate.Imie</label></td>
                            <td><label class="form-check-label w-100" for="candidate-@candidate.Id">@candidate.Nazwisko</label></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="submit" class="btn btn-primary">Oddaj głos</button>
        <a class="btn btn-link" asp-action="Dashboard">Wróć bez głosowania</a>
    </form>
}
