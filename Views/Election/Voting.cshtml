@model KandydatViewModel
@{
    ViewData["Title"] = "Głosowanie";
}
<h2>@Model.ElectionName</h2>
<p class="text-muted">Głosowanie trwa do @Model.DataZakonczenia.ToString("g"). Możesz oddać tylko jeden głos i nie można go zmienić.</p>
<hr />
@if (Model.Candidates.Count == 0)
{
    <div class="alert alert-warning" role="alert">Do tych wyborów nie dodano jeszcze kandydatów.</div>
}
else
{
    <form asp-action="Vote" method="post">
        <input type="hidden" asp-for="ElectionId" />
        <span asp-validation-for="SelectedCandidateId" class="text-danger d-block mb-2"></span>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Wybór</th>
                        <th scope="col">Imię</th>
                        <th scope="col">Nazwisko</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var candidate in Model.Candidates)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input" type="radio" name="SelectedCandidateId" id="candidate-@candidate.Id" value="@candidate.Id" required />
                            </td>
                            <td><label class="form-check-label w-100" for="candidate-@candidate.Id">@candidate.Imie</label></td>
                            <td><label class="form-check-label w-100" for="candidate-@candidate.Id">@candidate.Nazwisko</label></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="submit" class="btn btn-primary">Zagłosuj</button>
        <a class="btn btn-link" asp-action="Dashboard">Wróć</a>
    </form>
}
