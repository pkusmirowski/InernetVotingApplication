@model string?
@{
    ViewData["Title"] = "Błąd łańcucha";
}
<h2 class="text-danger">Głos nie został zapisany</h2>
<hr />
<div class="alert alert-danger" role="alert">
    Weryfikacja łańcucha głosów wyborów @(Model ?? "") wykazała naruszenie integralności. Oddawanie głosów zostało wstrzymane. Skontaktuj się z administratorem.
</div>
<a class="btn btn-link" asp-action="Dashboard">Wróć do panelu</a>
