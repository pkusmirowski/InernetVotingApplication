@model GlosowanieWyborczeViewModel
@{
    ViewData["Title"] = "Wyniki wyborów";
}
<h2>@Model.ElectionName</h2>
<p class="text-muted">@Model.DataRozpoczecia.ToString("g") &ndash; @Model.DataZakonczenia.ToString("g")</p>
<hr />
@switch (Model.Status)
{
    case ElectionStatus.Upcoming:
        <div class="alert alert-secondary" role="alert">Wybory jeszcze się nie rozpoczęły. Wróć po dacie rozpoczęcia, aby oddać głos.</div>
        break;
    case ElectionStatus.Ongoing:
        if (Model.HasVoted)
        {
            <div class="alert alert-info" role="alert">Oddałeś już swój głos w tych wyborach. Wyniki będą dostępne po ich zakończeniu.</div>
        }
        else
        {
            <div class="alert alert-info" role="alert">Wybory trwają. Wyniki będą dostępne po ich zakończeniu.</div>
            <a class="btn btn-primary" asp-action="Voting" asp-route-id="@Model.ElectionId">Zagłosuj</a>
        }
        break;
    default:
        @if (Model.LastVerification is null)
        {
            <div class="alert alert-secondary" role="alert">Łańcuch głosów nie został jeszcze zweryfikowany.</div>
        }
        else if (Model.LastVerification.IsValid)
        {
            <div class="alert alert-success" role="alert">Łańcuch głosów jest nienaruszony: @Model.LastVerification.BlockCount bloków, hashe i podpisy poprawne (weryfikacja @Model.LastVerification.Date.ToString("g")).</div>
        }
        else
        {
            <div class="alert alert-danger" role="alert"><b>Łańcuch głosów nie przechodzi weryfikacji</b> (@Model.LastVerification.Date.ToString("g")). Wyniki mogą być niewiarygodne. @Model.LastVerification.Details</div>
        }
        @if (Model.HeadHash != null)
        {
            <p class="small text-muted">Hash ostatniego bloku: <span class="hash-value">@Model.HeadHash</span> &middot; <a asp-action="Chain" asp-route-id="@Model.ElectionId">szczegóły łańcucha i eksport</a></p>
        }
        <p>Oddane głosy: <b>@Model.TotalVotes</b></p>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Kandydat</th>
                        <th scope="col">Głosy</th>
                        <th scope="col">Procent</th>
                        <th scope="col" class="w-25"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr class="@(Model.TotalVotes > 0 && row.CountedVotesPercentage > 50 ? "table-success" : "")">
                            <td>@row.CandidateName @row.CandidateSurname</td>
                            <td>@row.CountedVotes</td>
                            <td>@row.CountedVotesPercentage.ToString("0.##") %</td>
                            <td><div class="results-bar"><div style="width: @row.CountedVotesPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        break;
}
<a class="btn btn-link" asp-action="Dashboard">Wróć do panelu</a>
