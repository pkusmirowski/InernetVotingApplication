@model GlosowanieWyborczeViewModel
@{
    ViewData["Title"] = Model.Status == ElectionStatus.Ended ? "Wyniki wyborów" : "Informacje o wyborach";
}
<h2>@Model.ElectionName</h2>
<p class="text-muted">@Model.DataRozpoczecia.ToString("g") &ndash; @Model.DataZakonczenia.ToString("g")</p>
<hr />
@switch (Model.Status)
{
    case ElectionStatus.Upcoming:
        <div class="alert alert-secondary" role="alert">Te wybory jeszcze się nie rozpoczęły. Głosować będzie można od @Model.DataRozpoczecia.ToString("g").</div>
        break;
    case ElectionStatus.Ongoing:
        if (Model.HasVoted)
        {
            <div class="alert alert-info" role="alert">Twój głos w tych wyborach jest już oddany. Wyniki pokażemy po zakończeniu głosowania, czyli po @Model.DataZakonczenia.ToString("g").</div>
        }
        else
        {
            <div class="alert alert-info" role="alert">Głosowanie trwa do @Model.DataZakonczenia.ToString("g"). Wyniki pokażemy po jego zakończeniu.</div>
            <a class="btn btn-primary" asp-action="Voting" asp-route-id="@Model.ElectionId">Zagłosuj</a>
        }
        break;
    default:
        @if (Model.LastVerification is null)
        {
            <div class="alert alert-secondary" role="alert">Rejestr głosów tych wyborów nie został jeszcze skontrolowany.</div>
        }
        else if (Model.LastVerification.IsValid)
        {
            <div class="alert alert-success" role="alert">
                <b>Kontrola nie wykryła żadnych zmian w zapisanych głosach.</b>
                Liczba sprawdzonych głosów: @Model.LastVerification.BlockCount. Ostatnia kontrola: @Model.LastVerification.Date.ToString("g").
            </div>
        }
        else
        {
            <div class="alert alert-danger" role="alert">
                <p class="mb-1"><b>Uwaga: te wyniki mogą być niewiarygodne.</b></p>
                <p class="mb-0">Kontrola z @Model.LastVerification.Date.ToString("g") wykryła, że zapisane głosy mogły zostać zmienione. Sprawa wymaga wyjaśnienia.</p>
                @if (!string.IsNullOrEmpty(Model.LastVerification.Details))
                {
                    <details class="mt-2 small">
                        <summary>Szczegóły techniczne</summary>
                        <div class="mt-1">@Model.LastVerification.Details</div>
                    </details>
                }
            </div>
        }
        @if (Model.TotalVotes == 0)
        {
            <p>W tych wyborach nie oddano żadnego głosu.</p>
        }
        else
        {
            <p>Liczba oddanych głosów: <b>@Model.TotalVotes</b></p>
        }
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Kandydat</th>
                        <th scope="col">Liczba głosów</th>
                        <th scope="col">Procent głosów</th>
                        <th scope="col" class="w-25"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr class="@(Model.TotalVotes > 0 && row.CountedVotesPercentage > 50 ? "table-success" : "")">
                            <td>@row.CandidateName @row.CandidateSurname</td>
                            <td>@row.CountedVotes</td>
                            <td>@row.CountedVotesPercentage.ToString("0.##") %</td>
                            <td><div class="results-bar"><div style="width: @row.CountedVotesPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small text-muted">Chcesz wiedzieć, skąd pewność, że głosów nie zmieniono? <a asp-action="Chain" asp-route-id="@Model.ElectionId">Zobacz rejestr głosów tych wyborów</a>.</p>
        @if (Model.HeadHash != null)
        {
            <details class="small text-muted mb-3">
                <summary>Szczegóły techniczne</summary>
                <div class="mt-1">Kod ostatniego wpisu w rejestrze (hash): <span class="hash-value">@Model.HeadHash</span></div>
            </details>
        }
        break;
}
<a class="btn btn-link" asp-action="Dashboard">Wróć do listy wyborów</a>
