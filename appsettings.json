{
  "ConnectionStrings": {
    "InternetVotingDBConnection": "Server=localhost;Database=InternetVoting;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Smtp": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 25,
    "SecureSocket": "Auto",
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@internetvoting.local",
    "FromName": "Aplikacja do głosowania"
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDuration": "00:15:00",
    "PasswordResetTokenLifetime": "01:00:00"
  },
  "Seeding": {
    "AdminEmails": []
  },
  "AllowedHosts": "*",
  "Mail": {
    "PollInterval": "00:00:05",
    "MaxAttempts": 5,
    "BatchSize": 20
  },
  "Signing": {
    "PrivateKeyPem": "",
    "KeyFilePath": "App_Data/signing-key.pem",
    "AutoGenerateKey": false
  },
  "Chain": {
    "VerificationInterval": "00:05:00",
    "AnchorEveryBlocks": 100,
    "AnchorRecipients": [],
    "VerifyEndedElectionsFor": "30.00:00:00"
  },
  "RateLimiting": {
    "AuthPermitLimit": 20,
    "AuthWindow": "00:01:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
