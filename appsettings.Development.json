{
  "ConnectionStrings": {
    "InternetVotingDBConnection": "Server=localhost;Database=InternetVotingV2;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True;"
  },
  "Database": {
    "Provider": "SqlServer",
    "FallbackToSqliteWhenUnavailable": true,
    "ProbeTimeout": "00:00:03",
    "ApplyMigrationsOnStartup": true
  },
  "Smtp": {
    "Enabled": true,
    "PickupDirectory": "App_Data/mail"
  },
  "Signing": {
    "AutoGenerateKey": true
  },
  "Chain": {
    "VerificationInterval": "00:01:00",
    "AnchorEveryBlocks": 10,
    "AnchorRecipients": [
      "komisja@internetvoting.local"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "InternetVotingApplication": "Debug"
      }
    }
  },
  "Seeding": {
    "AdminEmails": [],
    "FirstActivatedUserIsAdmin": true,
    "SampleData": true,
    "TestAccounts": true
  }
}
